        {
          "@type": "Question",
          "@id": "https://nacho09021973.github.io/atlas-qca-students/#public-evidence-en",
          "url": "https://nacho09021973.github.io/atlas-qca-students/#public-evidence-en",
          "inLanguage": "en",
          "name": "Are the chapters and the canonical research atlas publicly accessible?",
          "acceptedAnswer": {
            "@type": "Answer",
            "inLanguage": "en",
            "text": "The six student chapters, their source and a copy of the canonical family atlas (in Spanish, folder canonical_atlas/) are public. The qca-causal-cones research repository, with its reports, certificates and current status, is private and requires access. This website does not expose those private certificates or establish the current status of unpublished research claims.",
            "citation": [
