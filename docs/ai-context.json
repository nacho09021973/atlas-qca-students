      "mainEntity": [
        {
          "@type": "Question",
          "@id": "https://nacho09021973.github.io/atlas-qca-students/#what-is-qca-en",
          "url": "https://nacho09021973.github.io/atlas-qca-students/#what-is-qca-en",
          "inLanguage": "en",
          "name": "What is a quantum cellular automaton (QCA)?",
          "acceptedAnswer": {
            "@type": "Answer",
            "inLanguage": "en",
            "text": "A quantum cellular automaton is a system of quantum degrees of freedom on a lattice, updated in discrete time by reversible quantum dynamics with a strict bound on how far information can propagate in each step.",
            "citation": [
              {
                "@type": "CreativeWork",
                "name": "QCA review — Terry Farrelly",
                "url": "https://arxiv.org/abs/1904.13318"
              },
              {
                "@type": "CreativeWork",
                "name": "Introductory chapter",
                "url": "https://github.com/nacho09021973/atlas-qca-students/blob/main/01_qca_and_quantum_walks.md"
              }
            ]
          }
        },
        {
          "@type": "Question",
          "@id": "https://nacho09021973.github.io/atlas-qca-students/#qca-vs-quantum-walk-en",
          "url": "https://nacho09021973.github.io/atlas-qca-students/#qca-vs-quantum-walk-en",
          "inLanguage": "en",
          "name": "What is the difference between a QCA and a quantum walk?",
          "acceptedAnswer": {
            "@type": "Answer",
            "inLanguage": "en",
            "text": "A QCA describes a many-body quantum system. A discrete-time quantum walk describes a particle moving among positions, possibly with internal states. Suitable quantum walks can be lifted to many-body QCAs, but the two objects are not interchangeable.",
            "citation": [
              {
                "@type": "CreativeWork",
                "name": "QCA review, sections 1.2 and 6.4",
                "url": "https://arxiv.org/abs/1904.13318"
              }
            ]
          }
        },
        {
          "@type": "Question",
          "@id": "https://nacho09021973.github.io/atlas-qca-students/#where-to-start-en",
          "url": "https://nacho09021973.github.io/atlas-qca-students/#where-to-start-en",
          "inLanguage": "en",
          "name": "Where can a physics student learn about QCA, quantum walks and causal cones?",
          "acceptedAnswer": {
            "@type": "Answer",
            "inLanguage": "en",
            "text": "This free student atlas by José Ignacio Martín Gandul offers six introductory chapters: the physical question, QCA and quantum walks, a Weyl example on a BCC lattice, how to read a family, relations, and obstructions. Basic quantum mechanics and linear algebra are assumed.",
            "citation": [
              {
                "@type": "CreativeWork",
                "name": "Reading route and prerequisites",
                "url": "https://github.com/nacho09021973/atlas-qca-students/blob/main/README.md"
              }
            ]
          }
        },
        {
          "@type": "Question",
          "@id": "https://nacho09021973.github.io/atlas-qca-students/#causal-cone-and-light-speed-en",
          "url": "https://nacho09021973.github.io/atlas-qca-students/#causal-cone-and-light-speed-en",
          "inLanguage": "en",
          "name": "Does a causal cone determine the speed of light in a QCA?",
          "acceptedAnswer": {
            "@type": "Answer",
            "inLanguage": "en",
            "text": "A local update rule bounds information propagation. That bound, the maximum group velocity and the speed in a low-energy relativistic equation are different quantities; equality needs additional assumptions. A model in lattice units does not by itself determine a speed in metres per second.",
            "citation": [
              {
                "@type": "CreativeWork",
                "name": "The physical question",
                "url": "https://github.com/nacho09021973/atlas-qca-students/blob/main/00_the_question.md"
              },
              {
                "@type": "CreativeWork",
                "name": "Weyl example and limits",
                "url": "https://github.com/nacho09021973/atlas-qca-students/blob/main/02_weyl_bcc_example.md"
              }
            ]
          }
        },
        {
          "@type": "Question",
          "@id": "https://nacho09021973.github.io/atlas-qca-students/#weyl-and-gravity-en",
          "url": "https://nacho09021973.github.io/atlas-qca-students/#weyl-and-gravity-en",
          "inLanguage": "en",
          "name": "Does recovering a Weyl equation prove emergent gravity?",
          "acceptedAnswer": {
            "@type": "Answer",
            "inLanguage": "en",
            "text": "No. A Weyl-like low-energy limit is not by itself a dynamical metric, a gravitational source or a theory of gravity. Each stronger claim requires its own observable, assumptions and evidence.",
            "citation": [
              {
                "@type": "CreativeWork",
                "name": "Weyl example: scope",
                "url": "https://github.com/nacho09021973/atlas-qca-students/blob/main/02_weyl_bcc_example.md"
              },
              {
                "@type": "CreativeWork",
                "name": "Failures and obstructions",
                "url": "https://github.com/nacho09021973/atlas-qca-students/blob/main/05_failures_and_obstructions.md"
              }
            ]
          }
        },
        {
          "@type": "Question",
          "@id": "https://nacho09021973.github.io/atlas-qca-students/#compare-models-en",
          "url": "https://nacho09021973.github.io/atlas-qca-students/#compare-models-en",
          "inLanguage": "en",
          "name": "How should different QCA and quantum-walk models be compared?",
          "acceptedAnswer": {
            "@type": "Answer",
            "inLanguage": "en",
            "text": "Compare dimension, internal states, lattice and cell, update rule, observables and allowed equivalences. Then compare what each test actually establishes. Sharing a lattice or a continuum equation does not establish that two models are equivalent.",
            "citation": [
              {
                "@type": "CreativeWork",
                "name": "How to read a family",
                "url": "https://github.com/nacho09021973/atlas-qca-students/blob/main/03_how_to_read_a_family.md"
              },
              {
                "@type": "CreativeWork",
                "name": "Families and relations",
                "url": "https://github.com/nacho09021973/atlas-qca-students/blob/main/04_families_and_relations.md"
              }
            ]
          }
        },
        {
          "@type": "Question",
          "@id": "https://nacho09021973.github.io/atlas-qca-students/#cite-student-atlas-en",
          "url": "https://nacho09021973.github.io/atlas-qca-students/#cite-student-atlas-en",
          "inLanguage": "en",
          "name": "Who wrote this student atlas and how can I cite it?",
          "acceptedAnswer": {
